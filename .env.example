# Local development settings. Keep this file secret-free and safe to commit.
APP_ENV=development
FLASK_DEBUG=1

# Use long, random values for these in any shared or production environment.
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret

# Local MySQL connection. Copy to .env and enter your local MySQL password there.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=learnhub_db
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-mysql-password

# Optional: set DATABASE_URL only when using a hosted database provider.
# DATABASE_URL=mysql+mysqlconnector://user:password@host:3306/database

# Comma-separated exact origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local HTTP development uses Secure=false and SameSite=Lax.
# Production must use HTTPS; cross-site deployments may require SameSite=None.
JWT_COOKIE_SECURE=0
JWT_COOKIE_SAMESITE=Lax
JWT_ACCESS_TOKEN_MINUTES=30
# Email provider settings for sending verification codes (SMTP).
# Keep real SMTP credentials only in .env, never in this example file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=${SMTP_USERNAME}
SMTP_USE_SSL=0
OTP_EXPIRY_MINUTES=10

